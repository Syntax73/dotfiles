# default system browser
browser "xdg-open %u"

# unbind keys
unbind-key ENTER
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key g
unbind-key G

# bind keys - vim style
bind-key j down
bind-key k up
bind-key l open
bind-key h quit
bind-key g home
bind-key G end

# theme
color title               color4   color0
color info                color4   color0
color background          default  default
color listnormal          default  default
color listnormal_unread   color15  default bold
color listfocus           color0   color4
color listfocus_unread    color4   default reverse bold
color article             color15  default

# open yt links with mpv
macro y set browser "setsid --fork mpv --ytdl-format='bv[height>=1080]+ba/b' %u"; open-in-browser; set browser "xdg-open %u";
